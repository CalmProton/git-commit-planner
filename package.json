{
  "name": "git-commit-planner",
  "displayName": "Git Commit Planner",
  "description": "Generate Git commit messages and plan multi-commit changes in VS Code with OpenRouter, Codex, or OpenCode.",
  "version": "2.4.0",
  "publisher": "MadElectron",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/CalmProton/git-commit-planner.git"
  },
  "bugs": {
    "url": "https://github.com/CalmProton/git-commit-planner/issues"
  },
  "homepage": "https://github.com/CalmProton/git-commit-planner#readme",
  "packageManager": "bun@1.3.13",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "commit",
    "commit message",
    "commit message generator",
    "git commit generator",
    "conventional commits",
    "commit planner",
    "source control",
    "openrouter",
    "openai",
    "codex",
    "opencode",
    "ai"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitCommitPlanner.generate",
        "title": "Generate",
        "category": "Git Commit Planner",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitCommitPlanner.setOpenRouterApiKey",
        "title": "Set OpenRouter API Key",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.clearOpenRouterApiKey",
        "title": "Clear OpenRouter API Key",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.codexSignIn",
        "title": "Sign in to Codex with ChatGPT",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.codexSignOut",
        "title": "Sign out of Codex",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.codexStatus",
        "title": "Show Codex Account Status",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.selectCodexModel",
        "title": "Select Codex Model",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.selectCodexReasoningEffort",
        "title": "Select Codex Reasoning Effort",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.opencodeStatus",
        "title": "Show OpenCode Provider Status",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.selectOpenCodeModel",
        "title": "Select OpenCode Model",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.selectOpenCodeVariant",
        "title": "Select OpenCode Model Variant",
        "category": "Git Commit Planner"
      },
      {
        "command": "gitCommitPlanner.planCommits",
        "title": "Plan Commits",
        "category": "Git Commit Planner",
        "icon": "$(list-tree)"
      },
      {
        "command": "gitCommitPlanner.commitPlannedCommits",
        "title": "Commit Plan",
        "category": "Git Commit Planner",
        "icon": "$(check-all)"
      },
      {
        "command": "gitCommitPlanner.regeneratePlan",
        "title": "Regenerate Plan",
        "category": "Git Commit Planner",
        "icon": "$(refresh)"
      },
      {
        "command": "gitCommitPlanner.editPlannedCommitMessage",
        "title": "Edit Commit Message",
        "category": "Git Commit Planner",
        "icon": "$(edit)"
      },
      {
        "command": "gitCommitPlanner.regeneratePlannedCommitMessage",
        "title": "Regenerate Commit Message",
        "category": "Git Commit Planner",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitCommitPlanner.movePlannedCommitFile",
        "title": "Move File to Commit",
        "category": "Git Commit Planner",
        "icon": "$(move)"
      },
      {
        "command": "gitCommitPlanner.addPlannedCommit",
        "title": "Add Commit Group",
        "category": "Git Commit Planner",
        "icon": "$(add)"
      },
      {
        "command": "gitCommitPlanner.removePlannedCommit",
        "title": "Remove Commit Group",
        "category": "Git Commit Planner",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitCommitPlanner.plannedCommits",
          "name": "Commit Planner",
          "contextualTitle": "Git Commit Planner"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitCommitPlanner.plannedCommits",
        "contents": "Use Commit Planner to split unstaged changes into multiple AI-generated commits.\n[Plan Commits](command:gitCommitPlanner.planCommits)",
        "when": "config.git.enabled"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitCommitPlanner.generate",
          "when": "scmProvider == git",
          "group": "navigation@9"
        },
        {
          "command": "gitCommitPlanner.planCommits",
          "when": "scmProvider == git",
          "group": "navigation@10"
        }
      ],
      "scm/repository": [
        {
          "command": "gitCommitPlanner.generate",
          "when": "scmProvider == git",
          "group": "inline@9"
        },
        {
          "command": "gitCommitPlanner.planCommits",
          "when": "scmProvider == git",
          "group": "inline@10"
        }
      ],
      "view/title": [
        {
          "command": "gitCommitPlanner.planCommits",
          "when": "view == gitCommitPlanner.plannedCommits",
          "group": "navigation@1"
        },
        {
          "command": "gitCommitPlanner.commitPlannedCommits",
          "when": "view == gitCommitPlanner.plannedCommits",
          "group": "navigation@2"
        },
        {
          "command": "gitCommitPlanner.regeneratePlan",
          "when": "view == gitCommitPlanner.plannedCommits",
          "group": "navigation@3"
        },
        {
          "command": "gitCommitPlanner.addPlannedCommit",
          "when": "view == gitCommitPlanner.plannedCommits",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "gitCommitPlanner.editPlannedCommitMessage",
          "when": "view == gitCommitPlanner.plannedCommits && viewItem == gitCommitPlanner.commit",
          "group": "inline@1"
        },
        {
          "command": "gitCommitPlanner.regeneratePlannedCommitMessage",
          "when": "view == gitCommitPlanner.plannedCommits && viewItem == gitCommitPlanner.commit",
          "group": "inline@2"
        },
        {
          "command": "gitCommitPlanner.removePlannedCommit",
          "when": "view == gitCommitPlanner.plannedCommits && viewItem == gitCommitPlanner.commit",
          "group": "inline@3"
        },
        {
          "command": "gitCommitPlanner.movePlannedCommitFile",
          "when": "view == gitCommitPlanner.plannedCommits && viewItem == gitCommitPlanner.file",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitCommitPlanner.generate",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.planCommits",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.commitPlannedCommits",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.regeneratePlan",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.editPlannedCommitMessage",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.regeneratePlannedCommitMessage",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.movePlannedCommitFile",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.addPlannedCommit",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.removePlannedCommit",
          "when": "config.git.enabled"
        },
        {
          "command": "gitCommitPlanner.setOpenRouterApiKey"
        },
        {
          "command": "gitCommitPlanner.clearOpenRouterApiKey"
        },
        {
          "command": "gitCommitPlanner.codexSignIn"
        },
        {
          "command": "gitCommitPlanner.codexSignOut"
        },
        {
          "command": "gitCommitPlanner.codexStatus"
        },
        {
          "command": "gitCommitPlanner.selectCodexModel"
        },
        {
          "command": "gitCommitPlanner.selectCodexReasoningEffort"
        },
        {
          "command": "gitCommitPlanner.opencodeStatus"
        },
        {
          "command": "gitCommitPlanner.selectOpenCodeModel"
        },
        {
          "command": "gitCommitPlanner.selectOpenCodeVariant"
        }
      ]
    },
    "configuration": [
      {
        "id": "gitCommitPlanner",
        "title": "Git Commit Planner",
        "order": 1,
        "properties": {
          "gitCommitPlanner.provider": {
            "type": "string",
            "scope": "resource",
            "enum": [
              "openrouter",
              "codex",
              "opencode"
            ],
            "default": "openrouter",
            "order": 1,
            "description": "Selects the provider for commit message generation. OpenCode uses its local server and configured providers. Codex uses the local Codex App Server."
          },
          "gitCommitPlanner.format": {
            "type": "string",
            "scope": "resource",
            "enum": [
              "conventional",
              "simple",
              "custom"
            ],
            "default": "conventional",
            "order": 2,
            "description": "Sets the commit message format. The default is Conventional Commits."
          },
          "gitCommitPlanner.includeBody": {
            "type": "string",
            "scope": "resource",
            "enum": [
              "never",
              "auto",
              "always"
            ],
            "default": "auto",
            "order": 3,
            "description": "Controls whether the generated commit message has a body."
          },
          "gitCommitPlanner.language": {
            "type": "string",
            "scope": "resource",
            "default": "en",
            "order": 4,
            "description": "Sets the language for the generated commit message."
          },
          "gitCommitPlanner.customInstructions": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 5,
            "markdownDescription": "Adds instructions to the built-in prompt. Use this field when `gitCommitPlanner.format` is `custom`."
          },
          "gitCommitPlanner.preferStaged": {
            "type": "boolean",
            "scope": "resource",
            "default": true,
            "order": 6,
            "description": "Uses staged changes when they exist. Otherwise, uses unstaged changes."
          }
        }
      },
      {
        "id": "gitCommitPlanner.openRouter",
        "title": "OpenRouter",
        "order": 2,
        "properties": {
          "gitCommitPlanner.openRouter.baseUrl": {
            "type": "string",
            "scope": "resource",
            "default": "https://openrouter.ai/api/v1",
            "order": 1,
            "description": "Sets the OpenRouter API base URL."
          },
          "gitCommitPlanner.openRouter.model": {
            "type": "string",
            "scope": "resource",
            "default": "openrouter/auto",
            "order": 2,
            "description": "Sets the OpenRouter model ID for commit message generation."
          },
          "gitCommitPlanner.openRouter.siteUrl": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 3,
            "description": "Sets the optional HTTP-Referer header value for OpenRouter."
          },
          "gitCommitPlanner.openRouter.appTitle": {
            "type": "string",
            "scope": "resource",
            "default": "Git Commit Planner VS Code Extension",
            "order": 4,
            "description": "Sets the optional X-Title header value for OpenRouter."
          },
          "gitCommitPlanner.openRouter.reasoningEffort": {
            "type": "string",
            "scope": "resource",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              ""
            ],
            "enumItemLabels": [
              "none (default)",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "model default"
            ],
            "enumDescriptions": [
              "Disables reasoning. This is the default.",
              "Uses the smallest reasoning budget.",
              "Uses a small reasoning budget.",
              "Uses a moderate reasoning budget.",
              "Uses a large reasoning budget.",
              "Uses a very large reasoning budget.",
              "Uses the largest reasoning budget.",
              "Omits the reasoning setting so the model uses its own default."
            ],
            "default": "none",
            "order": 5,
            "markdownDescription": "Sets the OpenRouter reasoning effort. Reasoning tokens count against `gitCommitPlanner.maxOutputTokens`. When a model rejects `none` because reasoning is mandatory, the extension retries without a reasoning setting."
          }
        }
      },
      {
        "id": "gitCommitPlanner.codex",
        "title": "Codex",
        "order": 3,
        "properties": {
          "gitCommitPlanner.codex.command": {
            "type": "string",
            "scope": "resource",
            "default": "codex",
            "order": 1,
            "description": "Sets the Codex CLI command that starts the local Codex App Server."
          },
          "gitCommitPlanner.codex.model": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 2,
            "markdownDescription": "Sets the Codex model ID. Leave this field empty to use the Codex default. Use **Git Commit Planner: Select Codex Model** to choose a model for the account."
          },
          "gitCommitPlanner.codex.reasoningEffort": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 3,
            "markdownDescription": "Sets the reasoning effort for the selected Codex model. Leave this field empty to use the model default. Use **Git Commit Planner: Select Codex Reasoning Effort** to choose a value."
          },
          "gitCommitPlanner.codex.fastMode": {
            "type": "boolean",
            "scope": "resource",
            "default": false,
            "order": 4,
            "markdownDescription": "Uses Codex Fast mode when the selected model supports it. Fast mode increases ChatGPT credit use or API cost. See [Codex Fast mode](https://learn.chatgpt.com/docs/agent-configuration/speed)."
          }
        }
      },
      {
        "id": "gitCommitPlanner.opencode",
        "title": "OpenCode",
        "order": 4,
        "properties": {
          "gitCommitPlanner.opencode.command": {
            "type": "string",
            "scope": "resource",
            "default": "opencode",
            "order": 1,
            "description": "Sets the OpenCode CLI command that starts the local OpenCode server."
          },
          "gitCommitPlanner.opencode.serverUrl": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 2,
            "markdownDescription": "Sets an existing OpenCode server URL. Leave this field empty to start a local server. Example: `http://127.0.0.1:4096`."
          },
          "gitCommitPlanner.opencode.model": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 3,
            "markdownDescription": "Sets the OpenCode provider/model reference. Leave this field empty to use the OpenCode default. Use **Git Commit Planner: Select OpenCode Model** to choose a connected model."
          },
          "gitCommitPlanner.opencode.variant": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "order": 4,
            "markdownDescription": "Sets the OpenCode model variant. Leave this field empty to use the model default. Use **Git Commit Planner: Select OpenCode Model Variant** to choose a variant."
          }
        }
      },
      {
        "id": "gitCommitPlanner.prompt",
        "title": "Prompt & Limits",
        "order": 5,
        "properties": {
          "gitCommitPlanner.maxDiffChars": {
            "type": "number",
            "scope": "resource",
            "default": 0,
            "minimum": 0,
            "maximum": 2000000,
            "order": 1,
            "markdownDescription": "Sets the maximum number of characters in the diff. Set this value to `0` to use token budgeting."
          },
          "gitCommitPlanner.modelContextTokens": {
            "type": "number",
            "scope": "resource",
            "default": 200000,
            "minimum": 4096,
            "maximum": 2000000,
            "order": 2,
            "description": "Sets the assumed model context size in tokens. The extension uses this value for prompt budgeting."
          },
          "gitCommitPlanner.maxPromptContextRatio": {
            "type": "number",
            "scope": "resource",
            "default": 0.6,
            "minimum": 0.05,
            "maximum": 0.95,
            "order": 3,
            "description": "Sets the maximum fraction of the model context that the prompt can use."
          },
          "gitCommitPlanner.maxPromptTokens": {
            "type": "number",
            "scope": "resource",
            "default": 0,
            "minimum": 0,
            "maximum": 2000000,
            "order": 4,
            "markdownDescription": "Sets the prompt token limit. Set this value to `0` to calculate the limit from the model context and prompt ratio."
          },
          "gitCommitPlanner.temperature": {
            "type": "number",
            "scope": "resource",
            "default": 0.2,
            "minimum": 0,
            "maximum": 2,
            "order": 5,
            "description": "Sets the OpenRouter sampling temperature. Codex and OpenCode use their model defaults."
          },
          "gitCommitPlanner.maxOutputTokens": {
            "type": "number",
            "scope": "resource",
            "default": 800,
            "minimum": 50,
            "maximum": 128000,
            "order": 6,
            "description": "Sets the maximum OpenRouter output tokens for a commit message. Codex and OpenCode use their model defaults."
          },
          "gitCommitPlanner.maxPlanOutputTokens": {
            "type": "number",
            "scope": "resource",
            "default": 32000,
            "minimum": 1000,
            "maximum": 128000,
            "order": 7,
            "description": "Sets the maximum OpenRouter output tokens for Commit Planner JSON. Codex and OpenCode use their model defaults."
          },
          "gitCommitPlanner.ignoredGlobs": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [
              "**/*.{png,jpg,jpeg,jfif,gif,webp,bmp,ico,tif,tiff,avif,heic,heif,svg}",
              "**/*.{fbx,glb,gltf,blend,blend1,3ds,max,dae,abc,stl,ply,obj,usd,usda,usdc,usdz}",
              "**/*.{mp4,mov,avi,mkv,webm,m4v,mp3,wav,ogg,oga,flac,m4a,aac,wma}",
              "**/*.{zip,gz,tgz,tar,rar,7z,bz2,xz,br}",
              "**/*.{woff,woff2,ttf,otf,eot}",
              "**/*.{pdf,psd,psb,ai,eps,sketch,xd,fig}",
              "**/*.{exe,dll,so,dylib,bin,wasm,class,jar,node,o,a,lib,pdb}",
              "**/*.lock",
              "**/package-lock.json",
              "**/npm-shrinkwrap.json",
              "**/pnpm-lock.yaml",
              "**/bun.lockb",
              "**/*.min.js",
              "**/*.min.css",
              "**/*.map"
            ],
            "order": 8,
            "markdownDescription": "Sets glob patterns for changed files whose content is left out of the prompt. Matching files still appear in the changed-file list. Patterns without a slash match at any depth, a trailing slash matches the whole directory, and matching is case-insensitive. Set this value to an empty array to send all file content."
          }
        }
      },
      {
        "id": "gitCommitPlanner.diagnostics",
        "title": "Diagnostics",
        "order": 6,
        "properties": {
          "gitCommitPlanner.debugLogging": {
            "type": "boolean",
            "scope": "resource",
            "default": false,
            "order": 1,
            "description": "Writes detailed generation data to the Git Commit Planner output channel. This data includes prompts, diffs, redacted requests, provider responses, and message cleanup."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "bun test",
    "package": "bun run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.2.0"
  }
}
